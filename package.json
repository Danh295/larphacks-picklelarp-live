{
  "name": "picklelarp-live",
  "version": "2.0.0",
  "private": true,
  "description": "PickleLARP Live: webcam pose app that makes you look like a televised pro",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "electron-packager . \"PickleLARP Live\" --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon.icns --extend-info=build/extend-info.plist --ignore=\"^/(dist|node_modules|research|scripts|test|\\.git|\\.claude)\" --ignore=\"^/(PLAN|SPEC|README|CLAUDE)\\.md$\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  }
}
